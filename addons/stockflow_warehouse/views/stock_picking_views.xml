<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_stockflow" model="ir.ui.view">
        <field name="name">stock.picking.form.stockflow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_stockflow_approve"
                    string="Approve Transfer"
                    type="object"
                    class="btn-secondary"
                    groups="stock.group_stock_manager"
                    invisible="not stockflow_approval_required or stockflow_approved or state in ('done', 'cancel')"
                />
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="stockflow_approval_required" invisible="1"/>
                <field name="stockflow_approved" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Approval" name="stockflow_approval" invisible="not stockflow_approval_required">
                    <group>
                        <group>
                            <field name="stockflow_requested_by" readonly="1"/>
                            <field name="stockflow_approved" readonly="1"/>
                        </group>
                        <group>
                            <field name="stockflow_approved_by" readonly="1"/>
                            <field name="stockflow_approved_on" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
