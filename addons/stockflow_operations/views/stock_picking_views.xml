<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_stockflow_operations" model="ir.ui.view">
        <field name="name">stock.picking.form.stockflow.operations</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="purchase_id" invisible="not purchase_id" readonly="1"/>
                <field name="sale_id" invisible="not sale_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
