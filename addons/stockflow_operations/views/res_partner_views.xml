<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_stockflow_operations" model="ir.ui.view">
        <field name="name">res.partner.form.stockflow.operations</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_stockflow_purchase_history"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    invisible="stockflow_purchase_count == 0"
                >
                    <field name="stockflow_purchase_count" widget="statinfo" string="Purchases"/>
                </button>
                <button
                    name="action_stockflow_sale_history"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-usd"
                    invisible="stockflow_sale_count == 0"
                >
                    <field name="stockflow_sale_count" widget="statinfo" string="Sales"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
