<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stockflow_inventory_report_form" model="ir.ui.view">
        <field name="name">stockflow.inventory.report.form</field>
        <field name="model">stockflow.inventory.report</field>
        <field name="arch" type="xml">
            <form string="Inventory Report">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_to"/>
                        <field name="hide_zero"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="categ_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_stockflow_sales_report_form" model="ir.ui.view">
        <field name="name">stockflow.sales.report.form</field>
        <field name="model">stockflow.sales.report</field>
        <field name="arch" type="xml">
            <form string="Sales Report">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="group_by"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_stockflow_purchase_report_form" model="ir.ui.view">
        <field name="name">stockflow.purchase.report.form</field>
        <field name="model">stockflow.purchase.report</field>
        <field name="arch" type="xml">
            <form string="Purchasing Report">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="group_by"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stockflow_inventory_report" model="ir.actions.act_window">
        <field name="name">Inventory Report</field>
        <field name="res_model">stockflow.inventory.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_stockflow_sales_report" model="ir.actions.act_window">
        <field name="name">Sales Report</field>
        <field name="res_model">stockflow.sales.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_stockflow_purchase_report" model="ir.actions.act_window">
        <field name="name">Purchasing Report</field>
        <field name="res_model">stockflow.purchase.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
