<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_stockflow" model="ir.ui.view">
        <field name="name">res.partner.form.stockflow</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="StockFlow" name="stockflow">
                    <group>
                        <field name="stockflow_code"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
