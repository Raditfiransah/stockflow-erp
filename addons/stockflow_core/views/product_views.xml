<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_stockflow_products_missing_sku" model="ir.actions.act_window">
        <field name="name">Products Without SKU</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_storable', '=', True), ('default_code', '=', False)]</field>
        <field name="context">{'search_default_filter_to_sell': 0}</field>
    </record>

    <record id="view_product_product_list_stockflow_sku" model="ir.ui.view">
        <field name="name">product.product.list.stockflow.sku</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <menuitem
        id="menu_stockflow_products_missing_sku"
        name="Products Without SKU"
        parent="stock.menu_product_in_config_stock"
        action="action_stockflow_products_missing_sku"
        sequence="90"
        groups="stock.group_stock_manager"
    />
</odoo>
